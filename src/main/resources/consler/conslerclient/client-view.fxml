<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="consler.conslerclient.ui.ClientController">
    <bottom>
        <HBox alignment="BOTTOM_LEFT" spacing="15.0" BorderPane.alignment="BOTTOM_LEFT">
            <Button onMouseClicked="#launchButtonClicked" style="-fx-pref-width: 330; -fx-pref-height: 110; -fx-font-size: 40;" text="Launch" />
            <ChoiceBox fx:id="launchChoiceBox" style="-fx-pref-width: 400; -fx-pref-height: 110; -fx-font-size: 30;" />
        </HBox>
    </bottom>

   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu text="Instance">
            <items>
              <MenuItem text="New" />
              <MenuItem text="Manage" />
            </items>
          </Menu>
          <Menu text="Help">
            <items>
              <MenuItem text="GitHub page" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
</BorderPane>
